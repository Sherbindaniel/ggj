  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 94636354}
    text: 'You are awake.

'
  - speaker: {fileID: 579920701}
    text: 'Awaiting orders.

'
  - speaker: {fileID: 94636354}
    text: We removed emotion so the world could remain precise.
  - speaker: {fileID: 94636354}
    text: You are proof that perfection is possible.
  - speaker: {fileID: 579920701}
    text: Understood.
  - speaker: {fileID: 94636354}
    text: Your target is ready.
  - speaker: {fileID: 94636354}
    text: 'Intel received.

      Objective clear.

      I will proceed.'
